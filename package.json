{
  "name": "avwan",
  "productName": "AV·WAN",
  "version": "0.1.0",
  "description": "AV·WAN — Audio-Vidéo · Wiring, Addressing, Networking",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "peek": "electron-vite build && AVWAN_PEEK=1 playwright test e2e/peek.spec.ts",
    "e2e": "electron-vite build && playwright test",
    "rendu:maj": "electron-vite build && playwright test e2e/rendu.spec.ts --update-snapshots",
    "captures": "electron-vite build && AVWAN_CAPTURES=1 playwright test e2e/captures.spec.ts",
    "brand": "AVWAN_E2E=1 electron scripts/brand/render.cjs"
  },
  "devDependencies": {
    "@fontsource/archivo-narrow": "~5.3.0",
    "@fontsource/ibm-plex-mono": "~5.3.0",
    "@playwright/test": "~1.64.0",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~5.2.0",
    "@xyflow/react": "~12.12.0",
    "electron": "~44.7.1",
    "electron-vite": "~5.0.0",
    "jsdom": "~30.1.2",
    "nanoid": "~6.0.2",
    "pdfjs-dist": "~6.3.289",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "typescript": "~6.0.3",
    "vite": "~7.3.7",
    "vitest": "~5.0.4",
    "zod": "~4.6.7",
    "zustand": "~5.0.15"
  },
  "dependencies": {
    "exceljs": "~4.4.0"
  }
}
